  "keyFeatures": [
    "Customization Projects for organizing and versioning ERP extensions",
    "Data Access Classes (DAC) for defining custom database tables and fields",
    "Business Query Language (BQL) for type-safe data queries",
    "Graph Extensions for adding business logic to existing application screens",
    "Custom Screens built with a visual layout designer",
    "Event Handlers for responding to record-level actions",
    "Packaging and deployment of customizations across environments"
  ],
  "publicApiSurface": [
    "PXGraph — base class for data graph definitions",
    "PXSelect / BQL queries — type-safe data access API",
    "PXCache — in-memory record cache and event source",
    "DAC field attributes — PXDBString, PXDBInt, PXDBDecimal, etc.",
    "Graph Extension (PXGraphExtension) — extend existing screens",
    "DAC Extension (PXCacheExtension) — extend existing tables",
    "RowSelected / RowInserted / RowUpdated / RowDeleted event handlers",
    "Customization Project XML manifest",
    "Package publish and deployment CLI"
  ]
}
